{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Log Pose",
  "version": "0.3.0",
  "identifier": "com.pedronly.log-pose",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Log Pose",
        "width": 1100,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pedruamerico/log-pose/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyOUQ4Qzc2MUUyRDJEOTUKUldTVkxTMGVkb3lkc3MyUENBNmc1N3p6VmE5dFVPakdFZ2svK21wMlRXUjI1R25WbTA2SlVHTWIK"
    }
  }
}
