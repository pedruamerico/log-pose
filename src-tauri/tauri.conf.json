{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Log Pose",
  "version": "1.2.0",
  "identifier": "com.pedronly.log-pose",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Log Pose",
        "width": 1100,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pedruamerico/log-pose/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NzA4ODg3Q0ZGOUZBMQpSV1Nobi85OGlBaG5EZmY5Y0V6enViai8vZlFKU3djWTluU0M4ZkdsWi9iQ3drU29hWHA5SUxyZAo="
    }
  }
}
